# Reviewer-only demo gateway configuration (copy to .env on Hydra, never commit .env).

# Public HTTPS origin routed through Cloudflare Tunnel (must match the Tunnel public hostname).
DEMO_PUBLIC_URL=https://demo.blobs.maddtechnologies.com

# Cloudflare Zero Trust Tunnel token (from Cloudflare One -> Networks -> Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Optional fixed reviewer credentials. Leave DEMO_PASSWORD and DEMO_AUTH_SECRET blank to
# auto-generate strong random values in /data/login on first boot.
DEMO_USERNAME=demo
DEMO_PASSWORD=
DEMO_AUTH_SECRET=

# Set to 1 to force a clean world re-seed on every container start.
DEMO_RESET_ON_START=0
