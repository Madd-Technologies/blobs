  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\" \"capture/**/*.test.ts\"",
    "dev:server": "scripts/dev-server.sh",
    "check": "tsc --noEmit && expo lint && npm test",
    "dev:stop": "scripts/dev-server.sh --stop",
    "smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/smoke.ts",
    "smoke:app": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/smoke-app.ts",
    "dev:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/dev-bots.ts seed",
    "dev:clean": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/dev-bots.ts clean",
    "smoke:auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke-auth.ts",
    "build:novnc": "node scripts/build-novnc.mjs",
    "build:mermaid": "node scripts/build-mermaid.mjs",
    "postinstall": "patch-package",
    "build:pdfjs": "node scripts/build-pdfjs.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:splash": "node scripts/build-splash.mjs",
    "demo:start": "scripts/demo/demo.sh start",
    "demo:stop": "scripts/demo/demo.sh stop",
    "demo:reset": "scripts/demo/demo.sh reset",
    "demo:status": "scripts/demo/demo.sh status",
    "demo:password": "scripts/demo/demo.sh password",
    "capture": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON capture/capture.ts",
    "capture:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON capture/capture.ts build",
    "capture:device": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON capture/capture.ts device",
    "capture:compose": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON capture/compose/compose.ts"
  },
  "private": true
}
